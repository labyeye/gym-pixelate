# Copy to .env and fill in. Never commit the real .env.

NODE_ENV=production
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/nestgym

# Auth. JWT_SECRET is required (use 32+ random characters). ENCRYPTION_SECRET protects stored
# Razorpay secrets, so changing it later makes saved gym keys unreadable.
JWT_SECRET=
JWT_EXPIRE=30d
ENCRYPTION_SECRET=

# Browser origins allowed to call the API (the gym web app). Comma separated extras in CORS_ORIGINS.
CLIENT_URL=https://gym.pixelatenest.com
FRONTEND_URL=https://gym.pixelatenest.com
CORS_ORIGINS=
# Public URL of this API (used for uploaded photo links)
API_BASE_URL=https://gym-backend.pixelatenest.com
BACKEND_URL=

# NestGym's own subscription billing (Razorpay account of Pixelate Nest)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=


# Email (invoices, notices)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=NestGym
SMTP_FROM_EMAIL=

# WhatsApp (platform number): OTP unlock/login and member payment links
WHATSAPP_PLATFORM_ACCESS_TOKEN=
WHATSAPP_PLATFORM_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE_NAME=user_otp
WHATSAPP_OTP_TEMPLATE_LANG=en
WHATSAPP_OTP_HAS_BUTTON=true
WHATSAPP_PAYLINK_TEMPLATE_NAME=nestgym_fee_payment_link
WHATSAPP_PAYLINK_TEMPLATE_LANG=en
PAYLINK_AUTO_SEND=false

# OTP abuse limits (optional)
OTP_COUNTRY_LIMITS=
OTP_BLOCKED_COUNTRIES=

# Passkeys (WebAuthn). RP ID = the web app's domain (or its parent domain, to share one passkey with the mobile app).
# PASSKEY_RP_ID=nestgym.example.com
# Extra allowed origins, comma separated (e.g. Android app origin android:apk-key-hash:...)
# PASSKEY_ORIGINS=
# iOS passkeys: <TeamID>.<bundle id>, e.g. ABCDE12345.com.nestgym (served at /.well-known/apple-app-site-association)
# APPLE_APP_ID=
# Android passkeys: release/debug signing SHA-256 fingerprints, comma separated (served at /.well-known/assetlinks.json)
# ANDROID_PACKAGE=com.nestgym
# ANDROID_SHA256=

# Payment safety net (utils/paymentSaga.js + paymentReconcile.js)
# Razorpay Dashboard > Settings > Webhooks > Add: URL https://<this API's domain>/api/webhooks/razorpay-billing,
# events payment.captured and order.paid, and paste the same secret here. It catches customers who paid but whose
# browser/app never called verify (the plan is activated, or the payment is refunded automatically).
RAZORPAY_WEBHOOK_SECRET=
# Refund emails use the SMTP_* settings above (SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, SMTP_FROM_NAME, SMTP_FROM_EMAIL).

# Encrypts member health, ID proof and emergency-contact data at rest (required in production). 32+ random characters; keep a copy safe:
# losing it makes that data unreadable. Existing rows: node scripts/encrypt-existing.js --apply
FIELD_ENCRYPTION_KEY=

# Web refresh cookie SameSite (lax | none). Use none only if the web app and API are on different sites.
# REFRESH_COOKIE_SAMESITE=lax

# Cloudflare Turnstile (optional). Secret here, site key in frontend VITE_TURNSTILE_SITE_KEY.
# TURNSTILE_SECRET=

# Member reminders (platform WhatsApp number). Each template takes 3 text params: name, gym name, date.
# WHATSAPP_REMINDER_EXPIRING_TEMPLATE=
# WHATSAPP_REMINDER_EXPIRED_TEMPLATE=
# WHATSAPP_REMINDER_BIRTHDAY_TEMPLATE=
# WHATSAPP_REMINDER_TEMPLATE_LANG=en

# Access tokens now last 15 minutes and are renewed with a refresh token (30 days, rotated). Override with JWT_EXPIRE.
# JWT_EXPIRE=15m

# WhatsApp credits: "true" turns credits on for every gym when it buys its first plan (gets 1000 welcome credits, once).
# Leave unset to enable gyms one by one with scripts/credits-admin.js
CREDITS_FOR_NEW_SIGNUPS=true
